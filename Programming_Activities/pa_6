# Programming Activity 1

# create a list with 3 favorite colors
colors = ["blue", "white", "red"]

# create a string with value "My favorite colors are: "
message = "My favorite colors are: "

# convert list to a comma separated string using join()
color_string = ", ".join(colors)

# concatenate the two strings and print the message
print(message + color_string)

# Programming Activity 2

# create a variable that stores the address the user enters
address = input("Enter your address: ")

# remove all whitespace from the string
address_no_spaces = address.replace(" ", "")

# use isalnum() to verify all remaining characters are letters or numbers
if address_no_spaces.isalnum():
    print("Valid address")
else:
    print("Invalid address")

# Programming Activity 3

# store the variables
num1 = int(input("Enter the first number: "))
num2 = int(input("Enter the second number: "))

# create the 2D list
table = []

# add rows and append values
for i in range(1, num1 + 1):
    row = []
    for j in range(1, num2 + 1):
        row.append(i * j)
    table.append(row)

# print the table using a nested for loop
print("\nMultiplication Table:")

for row in table:
    for value in row:
        print(value, end="\t")
    print()

