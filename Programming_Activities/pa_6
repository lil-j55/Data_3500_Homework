# Programming Activity 5

import json

# load person.json into a Python dictionary
with open("person.json", "r") as file:
    person = json.load(file)

# increase age by 1
person["age"] = person["age"] + 1

# save the updated dictionary to person.json
with open("person.json", "w") as file:
    json.dump(person, file, indent=4)

# open person.json again and verify the update
with open("person.json", "r") as file:
    updated_person = json.load(file)

print("Verified age:", updated_person["age"])

