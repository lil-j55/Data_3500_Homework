print("Welcome,", name + "!")

# Programming Activity 6
# Store the sentence in a variable
sentence = "dude, I just biked down that mountain and at first I was like Whoa, and then I was like Whoa"

# Print the original sentence
print(sentence)

# Capitalize the first letter of the sentence
sentence = sentence.capitalize()

# Split the sentence into a list of words
words = sentence.split()

# Change the first "Whoa," to "whoa,"
words[13] = "whoa,"

# Change the second "Whoa" to "WHOA"
words[-1] = "WHOA"

# Join the words back into a sentence
sentence = " ".join(words)

# Append an exclamation point
sentence += "!"

# Print the modified sentence
print(sentence)