# Programming Activity 2
import numpy as np

# Create a NumPy array of 100 numbers initialized to 0
numbers = np.zeros(100)

# Change the array values to random numbers
numbers = np.random.random(100)

# Display the array
print(numbers)

# Programming Activity 3
# Create a list of all even numbers from 2 to 100 using list comprehension
even_numbers = [num for num in range(2, 101) if num % 2 == 0]

print(even_numbers)

# Programming Activity 4
# Take a list of strings and remove leading/trailing spaces using list comprehension
strings = ["  apple  ", " banana", "orange ", "  grape  "]

cleaned_strings = [s.strip() for s in strings]

print("Original list:", strings)
print("Cleaned list:", cleaned_strings)

