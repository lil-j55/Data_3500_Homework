# Programming Activity 3
age = int(input("Enter the child's age: "))
weight = float(input("Enter the child's weight in pounds: "))

age_12_or_older = age >= 12
age_11_over_90 = (age == 11 and weight > 90)
under_11_over_100 = (age < 11 and weight > 100)

can_sit_front = age_12_or_older or age_11_over_90 or under_11_over_100

if can_sit_front:
    print("The child may sit in the front seat.")
else:
    print("The child may NOT sit in the front seat.")

